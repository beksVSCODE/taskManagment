<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- Маскируем секреты в логах -->
    <conversionRule conversionWord="mask" converterClass="com.example.demo.config.MaskingPatternLayout"/>

    <appender name="CONSOLE_MASKED" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="com.example.demo.config.MaskingPatternLayout">
                <maskPattern>"password"\s*:\s*"([^"]*)"</maskPattern>
                <maskPattern>"token"\s*:\s*"([^"]*)"</maskPattern>
                <maskPattern>"secret"\s*:\s*"([^"]*)"</maskPattern>
                <maskPattern>"apiKey"\s*:\s*"([^"]*)"</maskPattern>
                <maskPattern>api-key[=:]\s*(\S+)</maskPattern>
                <maskPattern>password[=:]\s*(\S+)</maskPattern>
                <maskPattern>Bearer\s+([A-Za-z0-9\-_=]+\.[A-Za-z0-9\-_=]+\.?[A-Za-z0-9\-_.+/=]*)</maskPattern>
                <!-- Include correlation ID in logs for request tracing -->
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO_CORRELATION}] %-5level %logger{36} - %msg%n</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE_MASKED"/>
    </root>

    <!-- Отключаем логирование SQL параметров с чувствительными данными -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    
    <!-- Отключаем логирование HTTP headers с токенами -->
    <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="WARN"/>
</configuration>
