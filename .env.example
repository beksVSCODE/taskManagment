# ====================================
# EXAMPLE ENVIRONMENT VARIABLES
# ====================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ────────────────────────────────────
# DATABASE (Docker Compose Production)
# ────────────────────────────────────
PGHOST=postgres  # Docker service name (for compose) or localhost (for local dev)
PGPORT=5432
PGDATABASE=dash_bord_prod
PGUSER=postgres
PGPASSWORD=  # REQUIRED: Set a strong password!

# Alternative DB connection variables
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# ────────────────────────────────────
# SECURITY (CRITICAL!)
# ────────────────────────────────────
# Generate strong secret: openssl rand -base64 64
JWT_SECRET=  # REQUIRED: Minimum 32 characters!
JWT_EXPIRATION=86400000  # 24 hours in milliseconds

# ────────────────────────────────────
# APPLICATION
# ────────────────────────────────────
PORT=8080

# JPA DDL mode (CRITICAL for production!)
# - update: Auto-update schema (DANGEROUS in production!)
# - validate: Only validate schema (SAFE for production)
# - none: Do nothing
JPA_DDL_AUTO=validate

# ────────────────────────────────────
# CORS (Frontend URLs)
# ────────────────────────────────────
# Production: https://yourdomain.com
# Development: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost

# ────────────────────────────────────
# TELEGRAM BOT (Optional)
# ────────────────────────────────────
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=dash_bord_bot
TELEGRAM_FRONTEND_BASE_URL=http://localhost

# Telegram Webhook Security (CRITICAL for production!)
# Generate token: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set this BEFORE running setup_telegram_webhook.py
TELEGRAM_WEBHOOK_SECRET_TOKEN=  # REQUIRED if Telegram bot enabled!

# ────────────────────────────────────
# AI SERVICES (Optional)
# ────────────────────────────────────
# Gemini API (for voice-to-text and task parsing)
GEMINI_API_KEY=

# Voice feature providers
VOICE_STT_PROVIDER=gemini  # or 'openai' or 'client'
VOICE_PARSE_PROVIDER=gemini  # or 'openai'

# OpenAI API (alternative for voice/parsing)
# VOICE_STT_OPENAI_API_KEY=
# VOICE_PARSE_OPENAI_API_KEY=
SHOW_SQL=false
DB_SSLMODE=disable

# ----------------
# CORS
# ----------------
# For development: comma-separated list of local URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8081
# For production: ONLY your production domain(s)
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ----------------
# FRONTEND
# ----------------
VITE_API_BASE_URL=http://localhost:8080/api
